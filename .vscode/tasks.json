{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Renderer",
      "type": "shell",
      "command": "bash",
      "args": ["scripts/dev-renderer-nvm.sh"],
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\s*VITE v",
          "endsPattern": "ready in .* ms"
        }
      }
    }
  ]
}