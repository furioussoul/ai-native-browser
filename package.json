{
  "name": "electron-browser-demo",
  "version": "0.1.0",
  "description": "基于 Electron 的轻量 Chrome 套壳浏览器示例",
  "main": "src/main.js",
  "scripts": {
    "start": "NODE_ENV=production npm run build && NODE_ENV=production electron .",
    "build": "NODE_ENV=production vite build",
    "dev": "NODE_ENV=development concurrently -k \"vite dev\" \"electron .\"",
    "dev:renderer": "set NODE_ENV=development && vite dev",
    "dev:electron": "set NODE_ENV=development && electron .",
    "dev:debug": "NODE_ENV=development concurrently -k \"vite dev\" \"electron --inspect=9229 .\"",
    "dev:debug-brk": "NODE_ENV=development concurrently -k \"vite dev\" \"electron --inspect-brk=9229 .\"",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'No lint configured'"
  },
  "keywords": [
    "electron",
    "browser",
    "chromium"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@eko-ai/eko": "^3.1.1",
    "html2canvas": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "electron": "^31.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
